# Hugging Face access token (required for gated models)
HF_TOKEN=hf_xxx

# Shared API key for vLLM OpenAI-compatible endpoints
VLLM_API_KEY=change-this-vllm-key

# LiteLLM master key (Open WebUI -> LiteLLM)
LITELLM_MASTER_KEY=change-this-litellm-master-key

# Open WebUI session secret
WEBUI_SECRET_KEY=change-this-webui-secret
WEBUI_ENABLE_SIGNUP=true

# -------------------------
# vLLM: Llama 3.1 8B Instruct
# -------------------------
LLAMA_MODEL_ID=meta-llama/Meta-Llama-3.1-8B-Instruct
LLAMA_SERVED_NAME=llama-3.1-8b-instruct

# -------------------------
# vLLM: Mistral 7B Instruct
# -------------------------
MISTRAL7B_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
MISTRAL7B_SERVED_NAME=mistral-7b-instruct
